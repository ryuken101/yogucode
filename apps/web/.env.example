# Copy to .env.local for local development. Never commit .env.local.

# Where the API lives. In development this is the Vite proxy prefix (see vite.config.ts),
# so the browser only ever sees one origin and no CORS is involved. At step 10 this
# becomes the deployed API's origin, which is when the API needs CORS.
VITE_API_BASE_URL=/api

# Supabase, for TEACHER sign-in only. Students never talk to Supabase — they get an
# app-issued session cookie from our own API. The project must be in ap-southeast-2 and
# must use an asymmetric (ES256) JWT signing key; the API rejects the legacy HS256 secret
# on purpose. See apps/api/src/app/auth/supabase_jwt.py.
VITE_SUPABASE_URL=
# The anon/publishable key. It ships in the browser bundle, so it is not a secret — but it
# still does not belong in git. The service_role key must NEVER appear in this app.
VITE_SUPABASE_ANON_KEY=
