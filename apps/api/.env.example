# Copy to .env for local development. Never commit .env.

# Local Postgres (Homebrew postgresql@16). Staging/production points at Supabase
# via Supavisor in transaction mode — see phase-1-plan.md, step 10.
DATABASE_URL=postgresql+asyncpg://localhost/coding_tool_dev
TEST_DATABASE_URL=postgresql+asyncpg://localhost/coding_tool_test

# Teacher sign-in is gated by this allowlist, checked before a users row is created.
# Without it, anyone who can request a magic link provisions a centre.
# Comma-separated; entries are either full addresses or @domain suffixes.
TEACHER_EMAIL_ALLOWLIST=you@example.com

# The one centre every allowlisted teacher joins. The first teacher to sign in creates
# it; everyone after joins it. A second centre means a second deployment, not a second
# teacher signing in.
CENTRE_SLUG=castle-hill
CENTRE_NAME=Magikid Castle Hill

# Student sessions: 12h absolute, 90min idle. Shared centre laptops — a session must
# survive a browser restart mid-lesson but not outlive the day.
STUDENT_SESSION_HOURS=12
STUDENT_SESSION_IDLE_MINUTES=90

# PIN lockout — phase-1-plan.md, PIN threat model.
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# Supabase (teacher auth). Filled in at step 10 when the ap-southeast-2 project exists.
# The issuer and JWKS URL are derived from this: {SUPABASE_URL}/auth/v1 and
# {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=
# "authenticated" for signed-in users; Supabase uses "anon" for anonymous sessions, so
# pinning this also rejects those.
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase's edge caches the JWKS for 10 minutes, so a shorter TTL buys nothing. An
# unknown kid forces a refresh regardless, which is how key rotation is picked up.
JWKS_CACHE_TTL_SECONDS=600
JWKS_MIN_REFRESH_INTERVAL_SECONDS=60
JWKS_REQUEST_TIMEOUT_SECONDS=5.0
